# Copy to .env.local for local development. Never commit real values.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Local Docker DB (see docker-compose.yml). For Supabase, use the transaction-pooler string
# from the dashboard's Connect panel (port 6543), plus ?sslmode=require. See docs/INFRASTRUCTURE.md.
DATABASE_URL=postgresql://fortuna:fortuna@localhost:5433/fortuna

# PEM of the Supabase Root 2021 CA (source and fingerprint in docs/INFRASTRUCTURE.md).
# Required for TLS verification against Supabase; leave unset for the local Docker DB.
DATABASE_CA_CERT=

# Vercel AI Gateway. On Vercel deployments, OIDC is used automatically and this is
# not needed. Locally, either set a key here or run `vercel env pull` to get an OIDC token.
AI_GATEWAY_API_KEY=

# Gateway model ID ("provider/model"). Intentionally unset until a model is chosen.
AI_MODEL_ID=
