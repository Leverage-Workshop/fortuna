# Copy to .env.local for local development. Never commit real values.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Local Docker DB (see docker-compose.yml). For Supabase, use the connection string from
# the Supabase dashboard (Connect > Session pooler), with sslmode=require.
DATABASE_URL=postgresql://fortuna:fortuna@localhost:5433/fortuna

# PEM contents of the database server's CA certificate (Supabase dashboard > Database
# settings > SSL configuration). Required for TLS verification; leave unset locally.
DATABASE_CA_CERT=

# Vercel AI Gateway. On Vercel deployments, OIDC is used automatically and this is
# not needed. Locally, either set a key here or run `vercel env pull` to get an OIDC token.
AI_GATEWAY_API_KEY=

# Gateway model ID ("provider/model"). Intentionally unset until a model is chosen.
AI_MODEL_ID=
